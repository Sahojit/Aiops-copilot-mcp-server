# Mock upstream service URLs (Stage 1)
RCA_SERVICE_URL=http://localhost:8001
COMMIT_RISK_SERVICE_URL=http://localhost:8002
ARBITRATION_SERVICE_URL=http://localhost:8003

# Postgres (Stage 2) — matches docker-compose.yml postgres service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiops_copilot

# MCP server (Stage 3)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080

# JSON map of API key -> {"caller_id": str, "can_approve_mitigations": bool}.
# If unset, mcp_server/auth.py falls back to the two dev keys below (dev only).
# API_KEYS_JSON={"dev-key-desktop-1":{"caller_id":"desktop-client-1","can_approve_mitigations":false},"dev-key-approver":{"caller_id":"oncall-lead","can_approve_mitigations":true}}

# Gated mitigation flow (Stage 4). Unconditional kill switch: when false,
# confirm_mitigation always returns "mitigations are currently disabled",
# regardless of caller permissions or the approved argument.
MITIGATIONS_ENABLED=false

# Dashboard (Stage 5)
DASHBOARD_REFRESH_SECONDS=10
